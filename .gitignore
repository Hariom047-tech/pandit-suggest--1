# dependencies
node_modules/

# env files
.env
.env.local
.env.test

# submitted contact/enquiry/newsletter data (dev store — see backend/src/utils/store.js)
backend/src/data/submissions/*.jsonl

# frontend build output
frontend/app/dist/

# OS
.DS_Store
Thumbs.db

# Uploaded media (served from backend/public) — user content, not source.
backend/public/uploads/**
!backend/public/uploads/**/.gitkeep

# Database backups (pg_dump output). These contain live user data and
# credentials-adjacent material — they belong in the encrypted S3 backup
# bucket, never in git. See docs/DATABASE_BACKUP_RESTORE.md.
db-backups/
*.dump
*.sql.gz

# RDS CA bundle is fetched at deploy time, not vendored.
certs/rds-global-bundle.pem
